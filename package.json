{
  "name": "@tedo-ai/harnas-typescript",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./log": {
      "types": "./dist/log/index.d.ts",
      "default": "./dist/log/index.js"
    },
    "./projections": {
      "types": "./dist/projections/index.d.ts",
      "default": "./dist/projections/index.js"
    },
    "./projections/openai": {
      "types": "./dist/projections/provider/openai.d.ts",
      "default": "./dist/projections/provider/openai.js"
    },
    "./projections/anthropic": {
      "types": "./dist/projections/provider/anthropic.d.ts",
      "default": "./dist/projections/provider/anthropic.js"
    },
    "./projections/gemini": {
      "types": "./dist/projections/provider/gemini.d.ts",
      "default": "./dist/projections/provider/gemini.js"
    },
    "./builtins": {
      "types": "./dist/builtins/index.d.ts",
      "default": "./dist/builtins/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "check:drift": "node scripts/check-drift.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/unit",
    "test:conformance:node": "tsx --test tests/conformance/node.test.ts",
    "test:conformance:node:all": "tsx src/testing/cli.ts --all",
    "test:conformance:provider-wire": "tsx src/testing/provider-stream-cli.ts",
    "test:conformance:roundtrip": "tsx scripts/roundtrip-matrix.mts",
    "test:conformance:bun": "bun test tests/conformance/bun.test.ts",
    "test:conformance:deno": "deno test --sloppy-imports --allow-read --allow-write --allow-env --allow-run --allow-sys=uid tests/conformance/deno.test.ts",
    "test:conformance:packed": "npm run build && node scripts/packed-import.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  }
}
